# Copy to .codex/config.toml (gitignored) and replace <account> with the local macOS account.
# Install the versioned broker first; do not point clients at the source tree or raw `unity mcp`.

[mcp_servers.unity]
command = "/Users/<account>/.unity-mcp-router/bin/unity-mcp-adapter"
args = ["--default", "UnityCodeMCPServer"]
startup_timeout_sec = 90
tool_timeout_sec = 310

# Headless canaries may auto-approve only this explicit safe-read set.
# Mutating Unity tools remain approval-gated.
[mcp_servers.unity.tools.editor_status]
approval_mode = "approve"

[mcp_servers.unity.tools.get_console_logs]
approval_mode = "approve"

[mcp_servers.unity.tools.list_tests]
approval_mode = "approve"

[mcp_servers.unity.tools.test_status]
approval_mode = "approve"

[mcp_servers.unity.tools.build_status]
approval_mode = "approve"

[mcp_servers.unity.tools.switch_build_target_status]
approval_mode = "approve"

[mcp_servers.unity.tools.recompile_status]
approval_mode = "approve"

[mcp_servers.unity.tools.package_status]
approval_mode = "approve"

[mcp_servers.unity.tools.list_open_scenes]
approval_mode = "approve"

[mcp_servers.unity.tools.unity_router_status]
approval_mode = "approve"

[mcp_servers.unity.tools.unity_router_doctor]
approval_mode = "approve"

[mcp_servers.unity.tools.unity_router_operation_status]
approval_mode = "approve"
